# Phase 0 defaults. Power management is deliberately off: the baseline variant
# has to be measurable before we start saving anything.
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_FREERTOS_HZ=1000

# Log verbosity. Set to WARN once the bring-up is done to keep the serial link
# quiet, which matters for the Pi-side parser.
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
