digraph architecture {
  rankdir=TB;
  bgcolor="white";
  nodesep=0.45;
  ranksep=0.55;
  node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=11,
        color="#555555", penwidth=1.2, margin="0.18,0.10"];
  edge [fontname="Helvetica", fontsize=9, color="#555555"];

  supply [label="5 V supply\n(HVPM during measurement)", fillcolor="#ececec"];

  esp [label=<<b>ESP32</b><br align="left"/><br align="left"/>sensor read · rule engine<br align="left"/>RTC ring buffer, 96 readings<br align="left"/>deep sleep between samples<br align="left"/>>, fillcolor="#f7e2d8"];

  pi [label=<<b>Raspberry Pi 4</b><br align="left"/><br align="left"/>supervisor.py — mode query, config push<br align="left"/>variant loop — V0 / V1 / V2 / V3<br align="left"/>vision — u2netp leaf segmentation<br align="left"/>dashboard :8081 · preview :8080<br align="left"/>>, fillcolor="#dbe9f6"];

  dht  [label="DHT11\nair T / RH", fillcolor="#f4f4f4"];
  soil [label="SEN0114\nsoil moisture", fillcolor="#f4f4f4"];
  buzz [label="Piezo buzzer", fillcolor="#f4f4f4"];
  cam  [label="Camera Module 3\n(CSI)", fillcolor="#f4f4f4"];

  supply -> esp [label=" VIN"];
  supply -> pi  [label=" 5 V"];

  esp -> pi [label="  UART2 · 115200 8N1\n  readings · rules · log? · bye\n  GPIO25 → GPIO3 wake pulse", penwidth=1.6];

  dht  -> esp;
  soil -> esp;
  esp  -> buzz [label=" rule fired"];
  cam  -> pi;

  { rank=same; supply; }
  { rank=same; esp; pi; }
  { rank=same; dht; soil; buzz; cam; }
}
